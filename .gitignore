.vscode/
.pixi/
*.pyc
dist/
build/
gtrace.egg-info/
gtrace-*/
/Manuals/references/
/docs/_build/
# Compiled by Sphinx from the .po files at build time
*.mo

# sphinx-autoapi generates its pages next to conf.py and removes them
# again when the build finishes. If that cleanup fails - on Windows a
# sync client or a virus scanner can hold the directory open - the tree
# is left behind, so it is ignored rather than committed by accident.
/docs/source/autoapi/

# Jupyter's autosaves, wherever a notebook happens to be opened
.ipynb_checkpoints/

# rope's cache, which an editor drops next to whatever it refactored
.ropeproject/

# pixi environments
.pixi/*
!.pixi/config.toml

# The pixi setup is a local development convenience, not part of the
# package. gtrace itself declares its dependencies in setup.py.
pixi.toml
pixi.lock

# Local working files - development notes, scratch notebooks and their
# outputs - live under local/, out of both git and the package.
/local/

# Everything the GUI verification suites generate
/tests/gui/_work/

# Test scripts run from the repo root or from tests/ drop their DXF here
/test.dxf
/tests/test.dxf

# Written by the tutorial when it is run
/docs/source/tutorial/tutorial_viewer.html
/docs/source/tutorial/tutorial_layout.json
/docs/source/tutorial/tutorial_layout.dxf
/docs/source/tutorial/bench_parts.json

# Left behind by pressing Save or Export in the viewer while trying
# something out. These are the buttons' default names, so they land
# wherever the notebook happened to be running.
/layout.json
/layout.dxf
/chosen.dxf
/tests/layout.json
/tests/layout.dxf
